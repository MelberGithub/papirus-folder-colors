#. TRANSLATORS warning message if papirus icons are not installed line 1
#: ../scripts/papirus-folder-colors:15
msgid "Papirus icon themes not found!"
msgstr "Δεν βρέθηκαν θέματα εικονιδίων Papirus!"

#. TRANSLATORS warning message if papirus icons are not installed line 2 -
#. text is followed by required path
#: ../scripts/papirus-folder-colors:17
msgid ""
"This tool requires the Papirus and Papirus-mxblue icon themes to be "
"installed in"
msgstr ""
"Αυτό το εργαλείο απαιτεί την εγκατάσταση των θεμάτων εικονιδίων Papirus και "
"Papirus-mxblue"

